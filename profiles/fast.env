# fast: the default profile plus lossy options, each priced in decode KLD against the official reference (decode-path KLD,
# forced acceptance, 8 windows / 4,080 rows; the lossless default is ~0.021, the budget for every lossy option together 0.08):
#   singleton drop-2 (S41): a verify row's two lowest expert picks are dropped when no other row of the step picked them
#     (router.cu at T <= 16, router_mega.cu at 16 < T <= 64): -10% step time, KLD 0.034 with the head below
#   MXFP8 verify head (H14): the LM head on the drafter's MXFP8 copy of the shared lm_head
. "$(dirname "${BASH_SOURCE[0]}")/default.env"
export DSV41_ROUTER_MEGA_MAX_T=64 # I19: the W4 router (router_mega.cu, bit-exact with the stock gate) up to T 64, so the
                                  #      singleton drop also runs in the 32-row copy verify
export DSV41_TOPK_DROP=12
export DSV41_DROP_DECODE_ONLY=1   # C19: the drop applies only inside the decode graphs; prompt prefill routes exactly
export DSV41_HEAD_FP8=dg
export DSV41_WS_MAX_BATCH=16      # decode-step graphs (and so the lossy options above) up to batch 16: lil 16 requests
                                  # +11..+20% (2,270 / 2,085 / 2,054 tok/s); decode KLD at batch 16 0.039 (default 0.029)
