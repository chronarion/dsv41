# default: the lossless profile (official precision: FP4 experts, FP8 / BF16 elsewhere; the BF16 verify head).
# Every option here is lossless (bitwise or FP32-summation-order class) or distribution-preserving (it changes only the
# drafts and so the acceptance, never the output distribution): decode KLD at the run-to-run floor.
# ds41's fastpath components (kernels/vendor/ds41, MIT) on the GB300; the cold experts on the RTX sidecar.
# J1a: 24 of each layer's 128 cold experts also live in GB300 HBM (MegaMoE rows 256..279, from the KV reserve: 4.2M tokens of
# KV remain); prefill computes them there (+17..25% at 8K-128K), decode keeps them on the RTX (unchanged)
ROWMAP=rowmap-warm-v1.json
FASTPATH=megamoe,peer3,a12_retire,fastload,coldskip,attn,preattn,preattn_cand,preattn_index,preattn_compress,lowb_aux,tail_swa_meta,tail_replay_skip,tail_embed,tail_ctxkv,tail_proj_side,topp_fast,tail_drafthead_mxfp8,tail_draft_embed,boundary,w8oproj,tail_markov_fused,engram_side
# DSpark drafts 7 per step; batch-1 steps verify 5 or 7 of them by expected tokens per unit of step time (dynk.py),
# or 31 copied tokens when the request's history repeats (suffix.py); batches of 2-4 verify 5, larger batches 3.
SPEC='{"method":"dspark","num_speculative_tokens":31,"num_speculative_tokens_per_batch_size":[[1,1,31],[2,4,5],[5,8,3],[9,32,3]],"draft_sample_method":"probabilistic","rejection_sample_method":"block"}'
export DSV41_MXFP8_OUT=1          # G2: the seams write the MXFP8 activations the next GEMM reads (bitwise)
export DSV41_LL_GEMM=1            # G3: low-latency MXFP8 GEMM tactics for M <= 8 (split-K: FP32-order class)
export DSV41_LL_WIDE=1            # I6: the same low-latency kernel with 16/32-row tiles for 8 < M <= 32 (batch 2-4, the 32-row
                                  #     copy verify; vLLM #63921): -4..-5% step there, FP32-order class
export DSV41_PROJ_SIDE_CAPTURE=1  # G4: the drafter's main projection on a side stream inside the step graph
export DSV41_SHARED_PF=1          # B1: the router's CTAs prefetch the layer's shared expert into L2 while HBM is idle
                                  #     (before their dependency wait; cache policy only): batch-1 step -0.4..-0.9%
export DSV41_DFLASH_PREP=1        # H15: the drafter's input prep pads in parallel (bitwise)
export DSV41_REPLAY_SKIP=1        # S60 / A4: intermediate prefill chunks skip the decoder replay nothing reads: prefill +9.5%
                                  #           at 32K-128K (replay_skip.py)
export DSV41_DYNK=0               # K3b below replaces S27's 5 or 7 drafts per batch-1 step (dynk.py)
export DSV41_CONF_WIDTH=0.3       # K3b: the batch-1 verify width comes from the current drafts' confidences, one step graph per
export DSV41_CONF_WIDTH_MODE=graphs   # width (conf_width.py, runner.py): prose c=1 +3..+8% over DynK, distribution-preserving
export DSV41_CONF_WIDTH_B=0.25    # K3: per-request widths at batch >= 2 as masked verify rows: prose c=2 +2%, c=4 +6%
export DSV41_ROUTER_MEGA=1        # I19: the W4 router at T 17-24 (bit-exact with the stock gate): masked rows need it at batch 3-4;
export DSV41_ROUTER_MEGA_MAX_T=24 #      the 32-row copy verify stays on the stock path (1x31 10.9 vs 11.3 ms)
export DSV41_SUFFIX=1             # G6: copy drafting with a 32-row verify at batch 1 (suffix.py)
export DSV41_DSPARK_K=7
export DSV41_WHOLE_STEP=1        # C4: each decode step replays one captured CUDA graph (runner.py)
